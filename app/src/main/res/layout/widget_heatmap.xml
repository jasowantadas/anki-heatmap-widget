<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="#F1EFE8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prev"
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F1EFE8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#F1EFE8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next"
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#F1EFE8"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Colours"
            android:padding="3dp"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/refresh"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- Grid area: stretches to the widget's real size, so it doesn't depend on what the launcher reports. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/months"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:paddingStart="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="W"
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="F"
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B4B2A9"
                    android:textSize="9sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Sets the grid's shape (weeks x 7) so every square stays square. -->
                <ImageView
                    android:id="@+id/aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/aspect_53" />

                <LinearLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Open the app to set up"
        android:textColor="#F1EFE8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#D3D1C7"
        android:textSize="12sp" />
</LinearLayout>
